# Postgres connection for the `prospection` database (cf. docs/INTEGRATION.md §2)
DATABASE_URL=postgresql://platform:platform@localhost:5432/prospection

# Frappe internal API (cf. docs/INTEGRATION.md §4/§6 and
# ../docs/FRAPPE_FALLBACK.md for the container/local automatic fallback).
# Leave FRAPPE_URL unset to let the service probe FRAPPE_URL_CONTAINER first,
# then fall back to FRAPPE_URL_LOCAL. Set FRAPPE_URL explicitly only to force
# a fixed URL (debug), which disables the fallback entirely.
FRAPPE_URL=
FRAPPE_URL_CONTAINER=http://frappe:8000
FRAPPE_URL_LOCAL=http://host.docker.internal:8000
INTERNAL_SERVICE_TOKEN=changeme

# Optional — if unset, emailGenerator.js falls back to a deterministic
# templated draft with provider:"stub" instead of calling OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS
FRONTEND_URL=http://localhost:3000

# Service port (cf. docs/INTEGRATION.md §2, prospection-service = 8084)
PORT=8084

# Optional tuning
LOG_LEVEL=info
SCORING_RULES_CACHE_TTL_MS=300000
IP_DETECTOR_TIMEOUT_MS=3000
FRAPPE_TIMEOUT_MS=5000
FRAPPE_PROBE_TIMEOUT_MS=1500
FRAPPE_URL_CACHE_TTL_MS=45000
OPENAI_TIMEOUT_MS=15000
