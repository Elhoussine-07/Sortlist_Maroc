# Base URL unique du Gateway (Spring Cloud Gateway) qui route :
#  - les appels Frappe   : POST {VITE_GATEWAY_URL}/api/method/platform_core.platform_core.api.<module>.<fonction>
#  - les microservices   : {VITE_GATEWAY_URL}/api/matching/..., /api/ia/..., /api/prospection/...
# Valeur par défaut en dev local hors docker (le gateway tourne sur le port 8080).
VITE_GATEWAY_URL=http://localhost:8080
