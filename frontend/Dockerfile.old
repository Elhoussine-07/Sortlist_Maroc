FROM node:22-slim AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

ARG VITE_GATEWAY_URL=http://localhost:8080
ARG VITE_NOTIFICATIONS_URL=http://localhost:8085
ENV VITE_GATEWAY_URL=$VITE_GATEWAY_URL
ENV VITE_NOTIFICATIONS_URL=$VITE_NOTIFICATIONS_URL

ENV NITRO_PRESET=node-server
RUN npm run build

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=build /app/.output/server ./

COPY --from=build /app/.output/public ./public

EXPOSE 3000
CMD ["node", "index.mjs"]
